# Discord application (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# Must match a redirect added under OAuth2 > Redirects
DISCORD_REDIRECT_URI=http://localhost:3001/auth/callback

# Infrastructure (docker compose up -d)
DATABASE_URL=postgres://csb:csb@localhost:5432/csb
REDIS_URL=redis://localhost:6379

# API / dashboard
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
# Long random string, used to sign the session cookie
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: register slash commands to one test server instantly (global commands can take a while)
DEV_GUILD_ID=
