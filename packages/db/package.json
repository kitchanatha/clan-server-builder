  },
  "dependencies": {
    "@csb/shared": "0.1.0",
    "drizzle-orm": "^0.38.4",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.2",
    "typescript": "^5.7.3"
  }
}
